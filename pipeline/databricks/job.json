{
  "name": "p2p-autopilot-daily",
  "description": "P2P Autopilot data layer: the day's SAP extract arrives, Auto Loader ingests it, dbt builds and tests the warehouse, the champion model scores the day's invoices. Replay of Sep-Nov 2018, score only.",
  "max_concurrent_runs": 1,
  "timeout_seconds": 3600,
  "schedule": {"quartz_cron_expression": "0 0 6 * * ?", "timezone_id": "America/Los_Angeles", "pause_status": "UNPAUSED"},
  "email_notifications": {"on_failure": ["${NOTIFY_EMAIL}"]},
  "tasks": [
    {"task_key": "arrive", "environment_key": "py",
     "spark_python_task": {"python_file": "${ROOT}/pipeline/arrive.py", "parameters": ["2018-09-01"]}},
    {"task_key": "ingest", "depends_on": [{"task_key": "arrive"}], "environment_key": "py",
     "spark_python_task": {"python_file": "${ROOT}/pipeline/ingest.py"}},
    {"task_key": "dbt_build", "depends_on": [{"task_key": "ingest"}], "environment_key": "dbt",
     "dbt_task": {"project_directory": "${ROOT}/dbt", "commands": ["dbt build"], "warehouse_id": "${WAREHOUSE_ID}",
                  "catalog": "workspace", "schema": "p2p_autopilot_dbt", "source": "WORKSPACE"}},
    {"task_key": "score", "depends_on": [{"task_key": "dbt_build"}], "environment_key": "py",
     "spark_python_task": {"python_file": "${ROOT}/pipeline/score.py"}}
  ],
  "environments": [
    {"environment_key": "py", "spec": {"environment_version": "2", "dependencies": ["mlflow>=3.5", "lightgbm==4.7.0"]}},
    {"environment_key": "dbt", "spec": {"environment_version": "2", "dependencies": ["dbt-databricks>=1.10,<1.12"]}}
  ]
}
